# 複製成 .env 後填入。.env 不會進 git。

# 伺服器監聽位址。維持 127.0.0.1，讓外部只能經由 Cloudflare Tunnel 連進來
HOST=127.0.0.1
PORT=3000

# 對外網址（npm run invite 產生邀請連結時使用），例如 https://trpg.example.com
PUBLIC_URL=http://localhost:3000

# Claude Console 申請的 API key。沒設定的話，會改用這台電腦 claude 登入的帳號額度
# ANTHROPIC_API_KEY=

# GM 設定（都有預設值，可以不填；註解要寫在獨立一行）
# GM_MODEL=claude-opus-5-5
# 思考深度：low / medium / high / xhigh / max
# GM_EFFORT=medium
# 單一回合的花費上限（美元）
# GM_MAX_BUDGET_PER_ROUND_USD=1
# 設成 1 時不呼叫 Claude，改用假的 GM（測試介面用）
# GM_MOCK=1
