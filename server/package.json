{
  "name": "trpg-tunnel-host-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "invite": "tsx scripts/invite.ts",
    "adopt-session": "tsx scripts/adopt-session.ts",
    "tunnel:setup": "tsx scripts/tunnel-setup.ts",
    "tunnel": "cloudflared tunnel --config ../tunnel/config.yml run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
